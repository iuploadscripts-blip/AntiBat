local isToggled = false
local batTPConnections = {}
local heartbeatConnection = nil

local function startAutoTPBatDetector()
    if heartbeatConnection then return end
    
    heartbeatConnection = RunService.Heartbeat:Connect(function()
        if not isToggled then return end
        
        local myChar = player.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        if not myRoot or not myHum then return end
        
        for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
            if p ~= player and p.Character then
                local theirHum = p.Character:FindFirstChildOfClass("Humanoid")
                local animator = theirHum and theirHum:FindFirstChildOfClass("Animator")
                local hasBat = false
                
                for _, child in ipairs(p.Character:GetChildren()) do
                    if child:IsA("Tool") and string.find(string.lower(child.Name), "bat") then
                        hasBat = true
                        break
                    end
                end
                
                if hasBat and animator and not batTPConnections[p] then
                    batTPConnections[p] = animator.AnimationPlayed:Connect(function(track)
                        if not isToggled then return end
                        
                        if track.Priority == Enum.AnimationPriority.Action or 
                           track.Priority == Enum.AnimationPriority.Action2 or 
                           track.Priority == Enum.AnimationPriority.Action3 or 
                           track.Priority == Enum.AnimationPriority.Action4 then
                            if myHum.FloorMaterial == Enum.Material.Air then
                                local rp = RaycastParams.new()
                                rp.FilterDescendantsInstances = {myChar}
                                rp.FilterType = Enum.RaycastFilterType.Exclude
                                
                                local rr = workspace:Raycast(myRoot.Position, Vector3.new(0, -2000, 0), rp)
                                if rr then
                                    local off = (myHum.HipHeight or 2) + (myRoot.Size.Y / 2) + 0.1
                                    myRoot.CFrame = CFrame.new(myRoot.Position.X, rr.Position.Y + off, myRoot.Position.Z) * myRoot.CFrame.Rotation
                                    myRoot.AssemblyLinearVelocity = Vector3.new(myRoot.AssemblyLinearVelocity.X, 0, myRoot.AssemblyLinearVelocity.Z)
                                    local bp = myChar:FindFirstChild("SpeedBypass")
                                    if bp then bp.Velocity = Vector3.new(bp.Velocity.X, 0, bp.Velocity.Z) end
                                end
                            end
                        end
                    end)
                elseif not hasBat and batTPConnections[p] then
                    batTPConnections[p]:Disconnect()
                    batTPConnections[p] = nil
                end
            end
        end
    end)
end

local function stopAutoTPBatDetector()
    if heartbeatConnection then 
        heartbeatConnection:Disconnect() 
        heartbeatConnection = nil 
    end
    for _, conn in pairs(batTPConnections) do 
        conn:Disconnect() 
    end
    batTPConnections = {}
end

local jumpPower = 50
local lastInfJumpTime = 0
local consecutiveJumps = 0

local function startInfJump()
    if Connections.InfJump then return end
    Connections.InfJump = RunService.Heartbeat:Connect(function()
        if not Enabled.InfJump or IsBinding then return end
        
        local char = Player.Character
        if not char then return end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not humanoid or not root then return end
        
        local currentCooldown = (Values.JumpCooldown or 3) / 10
        
        if humanoid.FloorMaterial ~= Enum.Material.Air and (tick() - lastInfJumpTime > currentCooldown + 0.05) then
            consecutiveJumps = 0
        end

        local isHoldingJump = false
        if not UserInputService:GetFocusedTextBox() then
            isHoldingJump = UserInputService:IsKeyDown(Enum.KeyCode.Space)
            if Enabled.ControllerMode then 
                pcall(function() 
                    isHoldingJump = isHoldingJump or UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonA) 
                end) 
            end
        end
        
        if humanoid.Jump then isHoldingJump = true end
        
        if isHoldingJump and (tick() - lastInfJumpTime >= currentCooldown) then
            lastInfJumpTime = tick()
            if Enabled.InfJump then
                root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, jumpPower, root.AssemblyLinearVelocity.Z)
                consecutiveJumps = consecutiveJumps + 1
            end
        end
    end)
end

local function stopInfJump()
    if not Enabled.InfJump then
        if Connections.InfJump then 
            Connections.InfJump:Disconnect() 
            Connections.InfJump = nil 
        end
    end
end

