    TweenService:Create(InfJumpToggleKnob, tweenInfo, {Position = targetPos, BackgroundColor3 = targetKnobColor}):Play()
    TweenService:Create(InfJumpToggleBg, tweenInfo, {BackgroundColor3 = targetBgColor}):Play()
    
    if Enabled.InfJump then
        startInfJump()
    else
        stopInfJump()
    end
end)

